# =============================================================================
# .env.example  ·  PLANTILLA de configuración de la IA (sin claves reales)
# =============================================================================
# 1. Copia este fichero:   cp .env.example .env      (Windows: copy .env.example .env)
# 2. Rellena los valores en .env (que está en .gitignore y NUNCA se sube).
#
# Cualquier servidor compatible con la API "chat/completions" de OpenAI sirve:
# los modelos del centro, Ollama en local, etc.

# URL base del servidor (sin /chat/completions al final). Debe empezar por http:// o https://
# Ejemplo con Ollama local:  http://localhost:11434/v1
TAREAS_IA_URL=http://localhost:11434/v1

# Nombre del modelo a usar. Ejemplo: llama3.2
TAREAS_IA_MODELO=llama3.2

# Clave de API. Los servidores locales suelen no necesitarla: déjala vacía.
TAREAS_IA_CLAVE=

# (Opcional) Ruta del fichero de acciones por defecto.
# TAREAS_CONFIG=acciones.json

# (Opcional) Pon 1 para ver el traceback completo si algo falla de forma inesperada.
# TAREAS_DEBUG=1
