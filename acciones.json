{
  "version": 1,
  "acciones": [
    {
      "nombre": "ordenar-descargas",
      "descripcion": "Mueve los PDF y documentos de Descargas a Documentos/PDF",
      "tipo": "mover",
      "origen": "~/Descargas",
      "filtro": { "extensiones": [".pdf", ".docx"] },
      "destino": "~/Documentos/PDF"
    },
    {
      "nombre": "renombrar-fotos",
      "descripcion": "Renombra las fotos con su fecha: 2026-10-26_001.jpg",
      "tipo": "renombrar",
      "filtro": { "extensiones": [".jpg", ".jpeg", ".png"] },
      "plantilla": "{fecha:%Y-%m-%d}_{n:03}{ext}"
    },
    {
      "nombre": "limpiar-temporales",
      "descripcion": "Borra los .tmp con más de 30 días",
      "tipo": "borrar",
      "filtro": { "patron": ".*\\.tmp$", "mas_antiguo_que_dias": 30 },
      "confirmar": true
    },
    {
      "nombre": "ordenar-por-tipo",
      "descripcion": "Reparte los ficheros en subcarpetas por tipo (PDF, Imagenes, Comprimidos...)",
      "tipo": "ordenar_por_tipo"
    },
    {
      "nombre": "quitar-duplicados",
      "descripcion": "Mueve a Duplicados los ficheros con el mismo contenido (mismo hash)",
      "tipo": "duplicados",
      "modo": "mover",
      "destino": "Duplicados"
    },
    {
      "nombre": "copia-apuntes",
      "descripcion": "Copia los apuntes (.md y .pdf) a una carpeta de copias de seguridad",
      "tipo": "copiar",
      "origen": "~/Documentos/Apuntes",
      "filtro": { "extensiones": [".md", ".pdf"] },
      "destino": "~/Copias/Apuntes"
    },
    {
      "nombre": "resumir-documentos",
      "descripcion": "Resume con IA los PDF y textos y guarda el resumen en Resumenes/",
      "tipo": "ia_resumir",
      "filtro": { "extensiones": [".pdf", ".txt", ".md"] },
      "destino": "Resumenes"
    },
    {
      "nombre": "renombrar-por-contenido",
      "descripcion": "La IA lee el principio de cada documento y propone un nombre que diga lo que es",
      "tipo": "ia_renombrar",
      "filtro": { "extensiones": [".pdf", ".txt", ".md"] }
    },
    {
      "nombre": "mantenimiento-semanal",
      "descripcion": "Limpia temporales, quita duplicados, resume y ordena: una orden, varios pasos",
      "tipo": "cadena",
      "pasos": ["limpiar-temporales", "quitar-duplicados", "resumir-documentos", "ordenar-por-tipo"]
    }
  ]
}
